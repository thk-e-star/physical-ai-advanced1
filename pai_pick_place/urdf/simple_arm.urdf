<?xml version="1.0"?>
<robot name="simple_arm">
  <link name="world"/>
  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual><geometry><cylinder radius="0.1" length="0.05"/></geometry><material name="gray"><color rgba="0.5 0.5 0.5 1.0"/></material></visual>
    <collision><geometry><cylinder radius="0.1" length="0.05"/></geometry></collision>
    <inertial><mass value="2.0"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial>
  </link>

  <link name="link1">
    <visual><geometry><cylinder radius="0.04" length="0.4"/></geometry><origin xyz="0 0 0.2" rpy="0 0 0"/></visual>
    <collision><geometry><cylinder radius="0.04" length="0.4"/></geometry><origin xyz="0 0 0.2" rpy="0 0 0"/></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>

  <link name="link2">
    <visual><geometry><cylinder radius="0.03" length="0.4"/></geometry><origin xyz="0 0 0.2" rpy="0 0 0"/></visual>
    <collision><geometry><cylinder radius="0.03" length="0.4"/></geometry><origin xyz="0 0 0.2" rpy="0 0 0"/></collision>
    <inertial><mass value="0.3"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial>
  </link>

  <link name="link3">
    <visual><geometry><cylinder radius="0.02" length="0.2"/></geometry><origin xyz="0 0 0.1" rpy="0 0 0"/></visual>
    <!-- collision disabled for suction grasp -->
    <inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <!-- 各関節に dynamics (damping / friction) を追加して揺れを抑止 -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/><child link="link1"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
    <dynamics damping="5.0" friction="0.5"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0 0 0.4" rpy="0 0.2 0"/><axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
    <dynamics damping="5.0" friction="0.5"/>
  </joint>

  <joint name="joint3" type="revolute">
    <parent link="link2"/><child link="link3"/>
    <origin xyz="0 0 0.4" rpy="0 0.2 0"/><axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
    <dynamics damping="5.0" friction="0.5"/>
  </joint>

  <gazebo>
    <plugin name="gazebo_ros_joint_pose_trajectory" filename="libgazebo_ros_joint_pose_trajectory.so">
      <ros>
        <namespace>/</namespace>
        <remapping>set_joint_trajectory:=arm_controller/joint_trajectory</remapping>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>
  </gazebo>
</robot>
